# =============================================================================
# CR+CRM - STAGING environment template
# =============================================================================
# Copy to a private, git-ignored location, e.g. `.env.staging`. Staging mirrors
# production dependencies (Postgres, Redis, real OAuth/SMTP providers) but
# points at non-production tenants/accounts and may enable relaxed limits for
# pre-release integration validation. MUST NOT contain real production
# credentials.
#
#   cp .env.staging.example .env.staging
#   docker compose -f docker-compose.prod.yml --env-file .env.staging up -d
# =============================================================================

APP_ENV=staging
RUNTIME_ENV_FILE=.env.staging

# Staging base URL (typically its own hostname; HTTPS if reachable publicly).
PUBLIC_BASE_URL=https://staging.cr.crm.example.com
PASSWORD_RESET_URL=https://staging.cr.crm.example.com/reset-password

POSTGRES_DB=crcrm_staging
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-a-staging-postgres-password
DATABASE_URL=postgresql+psycopg://app:replace-with-a-staging-postgres-password@postgres:5432/crcrm_staging

REDIS_URL=redis://redis:6379/1

JWT_SECRET=replace-with-a-staging-32-byte-secret
ENCRYPTION_KEY=replace-with-a-staging-32-byte-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Clerk (System A identity) - staging instance (could share dev instance).
CLERK_ISSUER=https://vocal-escargot-1567.clerk.accounts.dev
CLERK_JWKS_URL=https://vocal-escargot-1567.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=
AUTH_LEGACY_ENABLED=true
VITE_CLERK_PUBLISHABLE_KEY=replace-with-your-staging-publishable-key

ALLOWED_ORIGINS=https://staging.cr.crm.example.com
ALLOWED_HOSTS=staging.cr.crm.example.com,backend,nginx,frontend

# Staging uses dedicated provider test accounts, never production ones.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://staging.cr.crm.example.com/api/v1/senders/google/callback
GOOGLE_SENDER_REDIRECT_URI=https://staging.cr.crm.example.com/api/v1/senders/google/oauth/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_AUTHORITY=https://login.microsoftonline.com
MICROSOFT_REDIRECT_URI=https://staging.cr.crm.example.com/api/v1/senders/microsoft/callback
MICROSOFT_SENDER_REDIRECT_URI=https://staging.cr.crm.example.com/api/v1/senders/microsoft/oauth/callback

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_AUTHORITY=https://accounts.zoho.com
ZOHO_SENDER_REDIRECT_URI=https://staging.cr.crm.example.com/api/v1/senders/zoho/oauth/callback

# Staging may use a sandbox email relay; plaintext/private remain disabled.
TRANSACTIONAL_SMTP_HOST=smtp.staging.example.com
TRANSACTIONAL_SMTP_PORT=587
TRANSACTIONAL_SMTP_USERNAME=apikey
TRANSACTIONAL_SMTP_PASSWORD=replace-with-a-staging-smtp-key
TRANSACTIONAL_EMAIL_FROM=no-reply@staging.cr.crm.example.com
SMTP_ALLOW_PRIVATE_HOSTS=false
SMTP_ALLOW_PLAINTEXT_AUTH=false
SMTP_ALLOW_INSECURE_PORTS=false

AI_PROVIDER=mock
AI_REQUEST_TIMEOUT_MS=60000
AI_MONTHLY_BUDGET_USD=0
AI_MONTHLY_GENERATION_LIMIT=0

# WEBHOOK_SECRETS=google=<staging-secret>,microsoft=<staging-secret>

STORAGE_ROOT=/app/.local_uploads
IMPORT_FILE_RETENTION_DAYS=30

BACKUP_INTERVAL_SECONDS=3600
DB_RETENTION_DAYS=14
FILES_RETENTION_DAYS=30
CONFIG_RETENTION_DAYS=30
