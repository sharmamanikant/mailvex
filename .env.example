# =============================================================================
# CR+CRM - DEVELOPMENT environment template
#
# This file is the LOCAL DEVELOPMENT reference. It contains no real secrets.
# Production deploys use .env.production.example and staging uses
# .env.staging.example - copy those to a private, git-ignored file and fill in
# real credentials. NEVER put real credentials in a committed file.
# =============================================================================

APP_ENV=development
POSTGRES_DB=crcrm
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/crcrm
REDIS_URL=redis://redis:6379/0
JWT_SECRET=dev-only-jwt-secret-change-me-32b
ENCRYPTION_KEY=dev-only-encryption-key-change-me-32b
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,nginx
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_AUTHORITY=https://login.microsoftonline.com
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/senders/google/callback
GOOGLE_SENDER_REDIRECT_URI=http://localhost:8000/api/v1/senders/google/oauth/callback
GOOGLE_WORKSPACE_REDIRECT_URI=http://localhost:8000/api/v1/provider-connections/google/callback
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/senders/microsoft/callback
MICROSOFT_SENDER_REDIRECT_URI=http://localhost:8000/api/v1/senders/microsoft/oauth/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_AUTHORITY=https://accounts.zoho.com
ZOHO_SENDER_REDIRECT_URI=http://localhost:8000/api/v1/senders/zoho/oauth/callback
PUBLIC_BASE_URL=http://localhost:8000
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# -----------------------------------------------------------------------------
# Clerk (System A identity). Instance under https://vocal-escargot-1567.clerk.accounts.dev
# -----------------------------------------------------------------------------
# Backend JWT verification (must match the Clerk JWT issuer for the instance).
CLERK_ISSUER=https://vocal-escargot-1567.clerk.accounts.dev
CLERK_JWKS_URL=https://vocal-escargot-1567.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=
# Legacy email/password auth remains enabled during the controlled migration.
# Set to false once all tenants have onboarded to Clerk.
AUTH_LEGACY_ENABLED=true
# Frontend publishable key (also in frontend/.env.local in development).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_dm9jYWwtZXNjYXJnb3QtMTU2Ny5jbGVyay5hY2NvdW50cy5kZXYk

# SMTP (optional for local; only enable plaintext/private for local dev relays)
TRANSACTIONAL_SMTP_HOST=
TRANSACTIONAL_SMTP_PORT=587
TRANSACTIONAL_SMTP_USERNAME=
TRANSACTIONAL_SMTP_PASSWORD=
TRANSACTIONAL_EMAIL_FROM=
SMTP_ALLOW_PRIVATE_HOSTS=false
SMTP_ALLOW_PLAINTEXT_AUTH=false
SMTP_ALLOW_INSECURE_PORTS=false

# AI provider (mock by default in development)
AI_PROVIDER=mock
AI_REQUEST_TIMEOUT_MS=60000
AI_MONTHLY_BUDGET_USD=0
AI_MONTHLY_GENERATION_LIMIT=0

# Webhook HMAC secrets: provider=secret, comma-separated
# WEBHOOK_SECRETS=google=<dev-secret>,microsoft=<dev-secret>

# Backup + Disaster Recovery (Phase 22)
BACKUP_INTERVAL_SECONDS=3600
DB_RETENTION_DAYS=14
FILES_RETENTION_DAYS=30
CONFIG_RETENTION_DAYS=30
# STORAGE_ROOT=.local_uploads
# IMPORT_FILE_RETENTION_DAYS=30
