# =============================================================================
# CR+CRM - PRODUCTION environment template
# =============================================================================
# Copy to a private, git-ignored location, e.g. `.env.production`, and fill in
# real values. This file must NEVER contain real credentials and must never be
# committed.
#
# Deployment:
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# Required secrets with placeholders below cause a hard failure if unset:
#   JWT_SECRET, ENCRYPTION_KEY, POSTGRES_PASSWORD, GOOGLE/MICROSOFT secrets.
# Placeholders that begin with "replace-" are detected and rejected by the
# deployment preflight described in docs/deployment/production-release-gate.md.
# =============================================================================

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
APP_ENV=production
RUNTIME_ENV_FILE=.env.production

# Public base URL (used for sender OAuth redirects and link generation).
# MUST terminate in HTTPS in production.
PUBLIC_BASE_URL=https://cr.crm.example.com
PASSWORD_RESET_URL=https://cr.crm.example.com/reset-password

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=crcrm
POSTGRES_USER=app
# Real, strong password. Do NOT reuse the development value.
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DATABASE_URL=postgresql+psycopg://app:replace-with-a-strong-postgres-password@postgres:5432/crcrm

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# Redis is reachable only on the internal Docker network, but it still
# requires a password. REDIS_URL is derived from it in docker-compose.yml
# so the credential is defined in exactly one place. Do not set REDIS_URL
# here; a mismatch between the two is a silent outage.
REDIS_PASSWORD=CHANGE_ME_redis_password

# ---------------------------------------------------------------------------
# Auth / encryption (must be >= 32 bytes each)
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-random-32-byte-secret
ENCRYPTION_KEY=replace-with-a-random-32-byte-secret

# JWT lifetimes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# ---------------------------------------------------------------------------
# Clerk (System A identity). Set the issuer to the production Clerk instance.
# ---------------------------------------------------------------------------
CLERK_ISSUER=https://vocal-escargot-1567.clerk.accounts.dev
CLERK_JWKS_URL=https://vocal-escargot-1567.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=
# Keep LEGACY auth enabled until every tenant has migrated, then flip to false.
AUTH_LEGACY_ENABLED=true
# Frontend publishable key (injected into the frontend build, proxied via nginx).
VITE_CLERK_PUBLISHABLE_KEY=replace-with-your-clerk-publishable-key

# ---------------------------------------------------------------------------
# CORS / host allow-list (restrict to your real public origin + host)
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=https://cr.crm.example.com
ALLOWED_HOSTS=cr.crm.example.com,backend,nginx,frontend

# ---------------------------------------------------------------------------
# OAuth: Google (Gmail) - production client
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://cr.crm.example.com/api/v1/senders/google/callback
GOOGLE_SENDER_REDIRECT_URI=https://cr.crm.example.com/api/v1/senders/google/oauth/callback

# ---------------------------------------------------------------------------
# OAuth: Microsoft (Outlook) - production client
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_AUTHORITY=https://login.microsoftonline.com
MICROSOFT_REDIRECT_URI=https://cr.crm.example.com/api/v1/senders/microsoft/callback
MICROSOFT_SENDER_REDIRECT_URI=https://cr.crm.example.com/api/v1/senders/microsoft/oauth/callback

# ---------------------------------------------------------------------------
# OAuth: Zoho Mail - production client
# ---------------------------------------------------------------------------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_AUTHORITY=https://accounts.zoho.com
ZOHO_SENDER_REDIRECT_URI=https://cr.crm.example.com/api/v1/senders/zoho/oauth/callback

# ---------------------------------------------------------------------------
# SMTP (transactional email). Must be a properly secured relay in production.
# ---------------------------------------------------------------------------
TRANSACTIONAL_SMTP_HOST=smtp.example.com
TRANSACTIONAL_SMTP_PORT=587
TRANSACTIONAL_SMTP_USERNAME=apikey
TRANSACTIONAL_SMTP_PASSWORD=replace-with-an-smtp-api-key
TRANSACTIONAL_EMAIL_FROM=no-reply@cr.crm.example.com

# Never allow plaintext/private SMTP auth or insecure ports in production.
SMTP_ALLOW_PRIVATE_HOSTS=false
SMTP_ALLOW_PLAINTEXT_AUTH=false
SMTP_ALLOW_INSECURE_PORTS=false

# ---------------------------------------------------------------------------
# AI provider (set to a real provider key + credentials + budget/limits)
# ---------------------------------------------------------------------------
AI_PROVIDER=openai
AI_REQUEST_TIMEOUT_MS=60000
# Set real budget/limit via env before enabling metered AI.
AI_MONTHLY_BUDGET_USD=0
AI_MONTHLY_GENERATION_LIMIT=0

# ---------------------------------------------------------------------------
# Webhooks (provider name=HMAC secret, comma-separated). Generate real secrets.
# ---------------------------------------------------------------------------
# WEBHOOK_SECRETS=google=<secret>,microsoft=<secret>

# ---------------------------------------------------------------------------
# Storage / retention
# ---------------------------------------------------------------------------
STORAGE_ROOT=/app/.local_uploads
IMPORT_FILE_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Workers / scaling (optional; defaults applied by docker-compose.prod.yml)
# ---------------------------------------------------------------------------
# UVICORN_WORKERS=2
# CELERY_WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Backup & DR (frequency/retention; see docs/operations/backup-disaster-recovery.md)
# ---------------------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=3600
DB_RETENTION_DAYS=14
FILES_RETENTION_DAYS=30
CONFIG_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Contact validation engine
# ---------------------------------------------------------------------------
# Requires outbound DNS (UDP+TCP 53) from the worker network. Verify before
# release:  docker compose exec worker python -c "import dns.resolver as r; \
#   print(r.resolve('example.com','MX'))"
# Without DNS egress every domain resolves to UNKNOWN and validation is inert.
#
# SMTP recipient probing is OFF unless you deliberately enable it. It requires
# outbound TCP 25 and a PTR record, and it is reputation-sensitive. When egress
# is blocked the engine reports smtp_status=TIMEOUT / NOT_PROBED and never
# fabricates a result.
VALIDATION_SMTP_ENABLED=false
VALIDATION_SMTP_TIMEOUT_SECONDS=5.0
VALIDATION_SMTP_MAX_PROBES_PER_RUN=200
VALIDATION_SMTP_CIRCUIT_BREAKER_THRESHOLD=10
VALIDATION_SMTP_CIRCUIT_BREAKER_COOLDOWN_SECONDS=900

# Per-run cap on unique DNS lookups. Contacts past the cap are recorded as
# UNKNOWN, never as a pass. Raise for tenants with many distinct domains.
VALIDATION_MAX_UNIQUE_DNS_LOOKUPS=500
VALIDATION_DNS_TIMEOUT_SECONDS=2.0

# Caches (seconds). Domain facts change rarely; per-address results rarely change.
VALIDATION_DOMAIN_CACHE_TTL_SECONDS=21600
VALIDATION_EMAIL_CACHE_TTL_SECONDS=604800
VALIDATION_PHONE_CACHE_TTL_SECONDS=604800

# Scoring thresholds. VERIFIED is only ever written after an SMTP 250 on RCPT TO,
# so VALIDATION_SCORE_VERIFIED_MIN is unreachable while VALIDATION_SMTP_ENABLED
# is false. Nothing is auto-excluded on score alone; campaign selection does not
# read verification_status.
VALIDATION_SCORE_VERIFIED_MIN=90
VALIDATION_SCORE_LIKELY_VALID_MIN=70
VALIDATION_SCORE_NEEDS_REVIEW_MIN=45
VALIDATION_DUPLICATE_DEFINITE_MIN=80
VALIDATION_DUPLICATE_POSSIBLE_MIN=55

# Contacts per Celery verification task slice. Lower it if the worker OOMs on
# large bulk runs; raise it for throughput.
VERIFICATION_CHUNK_SIZE=200

# Default region for phone numbers stored without a country code. Set this to
# your actual operating region (the shipped default is IN). The verdict records
# that the assumption was applied.
VALIDATION_DEFAULT_PHONE_REGION=US

# ---------------------------------------------------------------------------
# Import lifecycle
# ---------------------------------------------------------------------------
# A running import refreshes ImportJob.updated_at on every committed batch. A
# job left active without a fresh heartbeat is assumed dead and re-queued. This
# MUST exceed your slowest batch, or live imports will be restarted mid-run.
IMPORT_STALE_JOB_SECONDS=300
IMPORT_RECLAIM_INTERVAL_SECONDS=60
