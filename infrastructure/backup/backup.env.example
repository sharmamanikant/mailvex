# Phase 22 - Backup & DR configuration (sample).
#
# Copy to a private location and reference from `docker compose` / cron. Do not
# commit real credentials.

# PostgreSQL connection (backup uses the same server as the app)
PGHOST=postgres
PGPORT=5432
PGUSER=app
PGPASSWORD=change-me
PGDATABASE=crcrm

# Where language-native backups are written (host-mounted volume).
BACKUP_DIR=/backups
# Alias seen from the host (docker volume mount target).
# HOST_BACKUP_DIR=./backups

# Retention policies (days)
DB_RETENTION_DAYS=14
FILES_RETENTION_DAYS=30
CONFIG_RETENTION_DAYS=30

# Application storage root to snapshot (inside the backend/backup container).
STORAGE_ROOT=/app/.local_uploads

# A configuration file/environment to capture alongside the backups.
# CONFIG_FILE=/app/.env

# Redis (ephemeral; best-effort only).
REDIS_HOST=redis

# Backup schedule (Docker sidecar uses this Cron-like interval in seconds).
BACKUP_INTERVAL_SECONDS=3600
